[Unit]
Description=Pi Zero Camera Web Control Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/picam-web/venv/bin/python /opt/picam-web/app.py
WorkingDirectory=/opt/picam-web

Restart=always
RestartSec=3

# www-data kullanıcısı ile çalıştır ama sudoers'a eklenmiş olmalı
User=root
StandardOutput=journal
StandardError=journal
SyslogIdentifier=picam-web

# Ortam değişkenleri
Environment=FLASK_ENV=production
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
